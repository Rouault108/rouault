{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rouault.local/schemas/closure-manifest.schema.json",
  "title": "Rouault R4 Closure Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "closure_manifest_id",
    "issue_id",
    "closure_input_manifest_anchors",
    "r4_phase_plan_artifact_ref",
    "plan_revision",
    "pre_final_ledger_artifact_ref",
    "final_verification_artifact_ref",
    "proposed_closure_disposition",
    "proposed_closure_timestamp",
    "actor"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "closure_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "closure_input_manifest_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "r4_phase_plan_artifact_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "pre_final_ledger_artifact_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "final_verification_artifact_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "proposed_closure_disposition": {
      "enum": ["proposed-closed", "proposed-not-closed"]
    },
    "proposed_closure_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "required": [
        "manifest_anchor_id",
        "manifest_id",
        "manifest_revision",
        "immutable_path",
        "manifest_sha256",
        "storage_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest_anchor_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_revision": {
          "type": "string",
          "pattern": "^rev-[0-9]{4}$"
        },
        "immutable_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "storage_scope": {
          "enum": ["repository-redacted", "private", "restricted"]
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "required": ["artifact_id", "artifact_revision", "storage_class", "immutable_locator"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_revision": {
          "type": "string",
          "pattern": "^rev-[0-9]{4}$"
        },
        "storage_class": {
          "enum": ["repository-redacted", "local-private", "ci-private", "external-restricted"]
        },
        "immutable_locator": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
