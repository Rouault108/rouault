{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rouault.local/schemas/a2-evidence-integrity-attestation.schema.json",
  "title": "Rouault A2 Evidence Integrity Attestation",
  "type": "object",
  "required": [
    "schema_version",
    "attestation_id",
    "issue_id",
    "risk_stage",
    "audit_level",
    "repository_redacted_evidence_index",
    "private_restricted_evidence_index",
    "redaction_policy",
    "retention_policy",
    "revocation_policy",
    "private_locator_leak_check",
    "non_public_digest_leak_check",
    "integrity_result",
    "derived_evidence_state",
    "timestamp",
    "actor",
    "human_approval"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "risk_stage": {
      "enum": ["R0", "R1", "R2-lite", "R2-full", "R3", "R4"]
    },
    "audit_level": {
      "type": "string",
      "const": "A2"
    },
    "repository_redacted_evidence_index": {
      "$ref": "#/$defs/evidenceIndexRef"
    },
    "private_restricted_evidence_index": {
      "$ref": "#/$defs/privateEvidenceIndexRef"
    },
    "public_safe_opaque_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "redaction_policy": {
      "type": "string",
      "minLength": 1
    },
    "retention_policy": {
      "type": "string",
      "minLength": 1
    },
    "revocation_policy": {
      "type": "string",
      "minLength": 1
    },
    "secret_revocation_rotation_record": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "private_locator_leak_check": {
      "enum": ["pass", "fail", "manual-review-required"]
    },
    "non_public_digest_leak_check": {
      "enum": ["pass", "fail", "manual-review-required"]
    },
    "integrity_result": {
      "enum": ["pass", "fail", "manual-review-required"]
    },
    "derived_evidence_state": {
      "enum": ["preserved", "not-preserved", "manual-review-required"]
    },
    "validation_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationEvidence"
      },
      "default": []
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "human_approval": {
      "type": "object",
      "required": ["approved", "approver", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "evidenceIndexRef": {
      "type": "object",
      "required": ["artifact_id", "artifact_revision", "public_locator"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_revision": {
          "type": "string",
          "pattern": "^rev-[0-9]{4}$"
        },
        "public_locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "privateEvidenceIndexRef": {
      "type": "object",
      "required": ["opaque_reference", "storage_scope"],
      "additionalProperties": false,
      "properties": {
        "opaque_reference": {
          "type": "string",
          "minLength": 1
        },
        "storage_scope": {
          "enum": ["local-private", "ci-private", "external-restricted"]
        }
      }
    },
    "validationEvidence": {
      "type": "object",
      "required": ["method", "result", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "verification_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": ["pass", "fail", "manual-review-required"]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "integrity_result": {
            "const": "pass"
          }
        },
        "required": ["integrity_result"]
      },
      "then": {
        "properties": {
          "derived_evidence_state": {
            "const": "preserved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "integrity_result": {
            "enum": ["fail", "manual-review-required"]
          }
        },
        "required": ["integrity_result"]
      },
      "then": {
        "properties": {
          "derived_evidence_state": {
            "enum": ["not-preserved", "manual-review-required"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "private_locator_leak_check": {
            "const": "fail"
          }
        },
        "required": ["private_locator_leak_check"]
      },
      "then": {
        "properties": {
          "integrity_result": {
            "const": "fail"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "non_public_digest_leak_check": {
            "const": "fail"
          }
        },
        "required": ["non_public_digest_leak_check"]
      },
      "then": {
        "properties": {
          "integrity_result": {
            "const": "fail"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "private_locator_leak_check": {
            "const": "manual-review-required"
          }
        },
        "required": ["private_locator_leak_check"]
      },
      "then": {
        "properties": {
          "integrity_result": {
            "enum": ["fail", "manual-review-required"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "non_public_digest_leak_check": {
            "const": "manual-review-required"
          }
        },
        "required": ["non_public_digest_leak_check"]
      },
      "then": {
        "properties": {
          "integrity_result": {
            "enum": ["fail", "manual-review-required"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "human_approval": {
            "properties": {
              "approved": {
                "const": false
              }
            },
            "required": ["approved"]
          }
        },
        "required": ["human_approval"]
      },
      "then": {
        "properties": {
          "integrity_result": {
            "enum": ["fail", "manual-review-required"]
          }
        }
      }
    }
  ]
}
