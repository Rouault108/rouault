{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rouault.local/schemas/closure-attestation.schema.json",
  "title": "Rouault R4 Closure Attestation",
  "type": "object",
  "required": [
    "schema_version",
    "closure_attestation_id",
    "issue_id",
    "r4_phase_plan_id",
    "closure_manifest_artifact_key",
    "final_manifest_anchors",
    "validation_result",
    "derived_closure_state",
    "timestamp",
    "actor"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "closure_attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "r4_phase_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "closure_manifest_artifact_key": {
      "type": "object",
      "required": ["artifact_id", "artifact_revision"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_revision": {
          "type": "string",
          "pattern": "^rev-[0-9]{4}$"
        }
      }
    },
    "final_manifest_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "validation_result": {
      "enum": ["pass", "fail", "manual-review-required"]
    },
    "derived_closure_state": {
      "enum": ["closed", "not-closed"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validation_result": {
            "const": "pass"
          }
        },
        "required": ["validation_result"]
      },
      "then": {
        "properties": {
          "derived_closure_state": {
            "enum": ["closed", "not-closed"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation_result": {
            "enum": ["fail", "manual-review-required"]
          }
        },
        "required": ["validation_result"]
      },
      "then": {
        "properties": {
          "derived_closure_state": {
            "const": "not-closed"
          }
        }
      }
    }
  ],
  "$defs": {
    "anchor": {
      "type": "object",
      "required": [
        "manifest_anchor_id",
        "manifest_id",
        "manifest_revision",
        "immutable_path",
        "manifest_sha256",
        "storage_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest_anchor_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_revision": {
          "type": "string",
          "pattern": "^rev-[0-9]{4}$"
        },
        "immutable_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "storage_scope": {
          "enum": ["repository-redacted", "private", "restricted"]
        },
        "git_commit_sha": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$"
        },
        "signature": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": ["git_commit_sha"],
          "properties": {
            "git_commit_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$"
            }
          }
        },
        {
          "required": ["signature"],
          "properties": {
            "signature": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
