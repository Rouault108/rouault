{
  "name": "rouault",
  "version": "1.0.0",
  "customElements": "custom-elements.json",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "analyze": "pnpm exec cem analyze --litelement --config cem.config.mjs",
    "test": "pnpm test:unit && pnpm test:ssr && pnpm test:storybook",
    "test:unit": "pnpm exec web-test-runner --config web-test-runner.config.mjs",
    "test:ssr": "vitest --project ssr",
    "test:storybook": "vitest --project storybook",
    "test:storybook:watch": "vitest --project storybook --watch",
    "test:storybook:ui": "vitest --project storybook --ui",
    "test:e2e": "playwright test",
    "test:all": "pnpm test:unit && pnpm test:ssr && pnpm test:storybook && pnpm test:e2e",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "storybook": "pnpm exec cem analyze --config cem.config.mjs && pnpm exec storybook dev",
    "storybook:build": "pnpm exec cem analyze --config cem.config.mjs && pnpm exec storybook build",
    "dev": "pnpm exec eleventy --config=eleventy.config.mjs --serve",
    "build": "pnpm exec eleventy --config=eleventy.config.mjs && tsx scripts/apply-lit-ssr.ts && tsx scripts/build-pagefind.ts",
    "start": "pnpm exec eleventy --config=eleventy.config.mjs --serve",
    "typecheck:node": "pnpm exec tsc -p tsconfig.node.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.6.2",
  "dependencies": {
    "@floating-ui/dom": "1.7.5",
    "@fontsource-variable/noto-sans-jp": "5.2.10",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@lit-labs/ssr": "~4.0.0",
    "@shikijs/transformers": "3.21.0",
    "iconify-icon": "3.0.2",
    "lit": "~3.3.2",
    "shiki": "3.21.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2",
    "@11ty/eleventy-plugin-vite": "7.0.0",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@eslint/js": "~9.39.2",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@iconify-json/lucide": "1.2.86",
    "@open-wc/testing": "4.0.0",
    "@playwright/test": "1.57.0",
    "@storybook/addon-a11y": "10.1.11",
    "@storybook/addon-themes": "10.1.11",
    "@storybook/addon-vitest": "10.1.11",
    "@storybook/web-components": "10.1.11",
    "@storybook/web-components-vite": "10.1.11",
    "@tsconfig/strictest": "~2.0.8",
    "@types/mocha": "~10.0.10",
    "@types/node": "~24.10.9",
    "@vitest/browser": "4.0.17",
    "@vitest/browser-playwright": "4.0.17",
    "@web/dev-server-esbuild": "1.0.4",
    "@web/test-runner": "0.20.2",
    "@web/test-runner-playwright": "0.11.1",
    "eslint": "~9.39.2",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-lit": "~2.1.1",
    "eslint-plugin-lit-a11y": "~5.1.1",
    "eslint-plugin-wc": "3.0.2",
    "globals": "~17.0.0",
    "pagefind": "1.4.0",
    "playwright": "1.57.0",
    "parse5": "7.3.0",
    "prettier": "~3.8.0",
    "rehype-katex": "~7.0.1",
    "remark-math": "~6.0.0",
    "storybook": "10.1.11",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "~8.53.0",
    "velite": "0.3.1",
    "vite": "7.3.1",
    "vitest": "4.0.17"
  }
}
